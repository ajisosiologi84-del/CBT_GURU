rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Helpers
    function isValidConfig(data) {
      return data is map &&
        (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 500)) &&
        (!('examTitle' in data) || (data.examTitle is string && data.examTitle.size() <= 500)) &&
        (!('questions' in data) || (data.questions is list && data.questions.size() <= 1000)) &&
        (!('students' in data) || (data.students is list && data.students.size() <= 10000)) &&
        (!('teachers' in data) || (data.teachers is list && data.teachers.size() <= 1000));
    }

    function isValidStudentResult(data) {
      return data is map &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('score' in data) || data.score is number);
    }

    function isValidTeacher(data) {
      return data is map &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (('nip' in data && data.nip is string) || ('username' in data && data.username is string)) &&
        (('nama' in data && data.nama is string) || ('name' in data && data.name is string));
    }

    function isValidStudent(data) {
      return data is map &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('nis' in data) || (data.nis is string && data.nis.size() <= 100)) &&
        (!('nama' in data) || (data.nama is string && data.nama.size() <= 300));
    }

    // CBT Configuration
    match /cbt_config/{configId} {
      allow read: if isValidId(configId);
      allow create, update: if isValidId(configId) && isValidConfig(incoming());
      allow delete: if isValidId(configId);
    }

    match /cbt_configs/{configId} {
      allow read: if isValidId(configId);
      allow create, update: if isValidId(configId) && isValidConfig(incoming());
      allow delete: if isValidId(configId);
    }

    // Student Results
    match /student_results/{resultId} {
      allow read: if isValidId(resultId);
      allow create, update: if isValidId(resultId) && isValidStudentResult(incoming());
      allow delete: if isValidId(resultId);
    }

    match /cbt_results/{resultId} {
      allow read: if isValidId(resultId);
      allow create, update: if isValidId(resultId) && isValidStudentResult(incoming());
      allow delete: if isValidId(resultId);
    }

    // Teacher Accounts
    match /teacher_accounts/{teacherId} {
      allow read: if isValidId(teacherId);
      allow create, update: if isValidId(teacherId) && isValidTeacher(incoming());
      allow delete: if isValidId(teacherId);
    }

    match /cbt_teachers/{teacherId} {
      allow read: if isValidId(teacherId);
      allow create, update: if isValidId(teacherId) && isValidTeacher(incoming());
      allow delete: if isValidId(teacherId);
    }

    // Admin Accounts
    match /admin_accounts/{adminId} {
      allow read, write: if isValidId(adminId);
    }

    // Student Master Data
    match /cbt_students/{studentId} {
      allow read: if isValidId(studentId);
      allow create, update: if isValidId(studentId) && isValidStudent(incoming());
      allow delete: if isValidId(studentId);
    }

    // Default deny for unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
