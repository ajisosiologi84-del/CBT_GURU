rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write on cbt_config for exam sync
    match /cbt_config/{docId} {
      allow read, write: if true;
    }
    
    // Allow student results reading and writing
    match /student_results/{resultId} {
      allow read, write: if true;
    }
    
    // Allow teacher accounts access
    match /teacher_accounts/{teacherId} {
      allow read, write: if true;
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
